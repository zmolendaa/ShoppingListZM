<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:ShoppingListZM.ViewModels"
             xmlns:models="clr-namespace:ShoppingListZM.Models"
             xmlns:controls="clr-namespace:ShoppingListZM.Controls"
             x:Class="ShoppingListZM.Views.MainPage"
             x:Name="page"
             Title="Lista Zakupów"
             x:DataType="viewModels:ViewModel">

    <ContentPage.BindingContext>
        <viewModels:ViewModel />
    </ContentPage.BindingContext>

    <Grid RowDefinitions="Auto, *" BackgroundColor="#FFF9FB">
        <Button Text="+ NOWA KATEGORIA" Command="{Binding AddCategoryCommand}" 
                Margin="15" BackgroundColor="#FF69B4" TextColor="White" CornerRadius="25" HeightRequest="50" FontAttributes="Bold" />

        <CollectionView Grid.Row="1" ItemsSource="{Binding Categories}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Category">
                    <VerticalStackLayout Padding="10,0,10,15">
                        <Frame BackgroundColor="#FFD1DC" BorderColor="Transparent" CornerRadius="12" Padding="12">
                            <Grid ColumnDefinitions="*, Auto">
                                <Label Text="{Binding Name}" FontSize="18" FontAttributes="Bold" TextColor="#D02090" VerticalOptions="Center" />
                                <Button Grid.Column="1" Text="+ Produkt" FontSize="11" BackgroundColor="#FF69B4" CornerRadius="15" 
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:ViewModel}}, Path=AddProductCommand}" 
                                        CommandParameter="{Binding .}" HeightRequest="30" />
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:ViewModel}}, Path=ToggleExpandCommand}" CommandParameter="{Binding .}" />
                                </Grid.GestureRecognizers>
                            </Grid>
                        </Frame>

                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Products}" IsVisible="{Binding IsExpanded}" Margin="10,5,0,0">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <controls:ProductView />
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>